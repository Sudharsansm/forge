# Forge reads real environment variables (it does not load .env itself): export these, or pass them with `docker run --env-file .env`.
# All values are optional on localhost.
FORGE_HOST=127.0.0.1
FORGE_PORT=8000
# REQUIRED if FORGE_HOST is not local. Sent as "Authorization: Bearer <key>" or "X-API-Key".
FORGE_API_KEY=
# Comma-separated Host names accepted when behind a proxy (DNS-rebinding guard), e.g. forge.example.com
FORGE_ALLOWED_HOSTS=
# Public https URL of this server; enables "open in a new tab" from MCP hosts
FORGE_PUBLIC_URL=
FORGE_CORS=http://localhost:3000,http://127.0.0.1:3000
FORGE_PROJECTS_DIR=
# Documents
FORGE_MAX_UPLOAD_MB=15
FORGE_LIBRARY_VERSIONS=30
FORGE_HISTORY_MAX_MB=40
FORGE_LOG_LEVEL=INFO
# Only for the standalone "Edit with Claude" button
ANTHROPIC_API_KEY=
