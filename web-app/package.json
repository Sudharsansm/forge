{
  "name": "forge-workbench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-preview-libs.mjs",
    "build": "tsc -b && vite build",
    "build:ui": "npm run build && node scripts/install-ui.mjs",
    "preview": "vite preview",
    "build:host": "vite build --config vite.host.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@tailwindcss/browser": "^4.3.3",
    "codemirror": "^6.0.1",
    "forge": "file:..",
    "magic-string": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "framer-motion": "^14.2.0",
    "lucide-react": "^1.56.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.7"
  }
}
